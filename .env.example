# Copy to .env and fill in. Every config.json setting works here as
# PLEXBOT_<SECTION>_<KEY>; blank lines are ignored and these override config.json.

# Required
PLEXBOT_CORE_TOKEN=
PLEXBOT_TAUTULLI_IP=192.168.1.10:8181
PLEXBOT_TAUTULLI_APIKEY=

# Your Discord server's ID. Keep it set so only your server can use the bot.
PLEXBOT_DISCORD_SERVER_ID=

# Optional. Lists are comma-separated IDs.
# PLEXBOT_TAUTULLI_USE_HTTPS=false
# PLEXBOT_DISCORD_ADMIN_IDS=
# PLEXBOT_DISCORD_STREAM_MANAGER_IDS=
# PLEXBOT_DISCORD_TOP_ROLE_ID=
# PLEXBOT_DISCORD_SECOND_ROLE_ID=
# PLEXBOT_DISCORD_THIRD_ROLE_ID=
# PLEXBOT_DISCORD_SHOW_RECENT_VIEWERS=false
# PLEXBOT_QBITTORRENT_IP=
# PLEXBOT_QBITTORRENT_PORT=8080
# PLEXBOT_QBITTORRENT_USERNAME=
# PLEXBOT_QBITTORRENT_PASSWORD=
# PLEXBOT_CORE_LOG_LEVEL=INFO

# Container timezone
# TZ=Europe/London
